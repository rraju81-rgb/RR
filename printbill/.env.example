# ─────────────────────────────────────────────────────────────────────────────
# PrintBill configuration
#
# Copy to `.env` and fill in. Nothing here is read directly by the app — every
# value passes through src/config/env.ts, which validates it at boot and
# refuses to start in production if a credential is missing.
# ─────────────────────────────────────────────────────────────────────────────

NODE_ENV=development
PORT=3000

# Public HTTPS URL of this service. Meta and Razorpay both call back here, and
# invoice links are built from it. In development use an ngrok/cloudflared URL.
PUBLIC_BASE_URL=https://your-domain.example.com

DATABASE_PATH=./data/printbill.db
INVOICE_DIR=./data/invoices

# Signs invoice download tokens. Generate with:  openssl rand -base64 32
APP_SECRET=change-me-to-32-random-bytes
# Password for the /admin console.               openssl rand -base64 24
ADMIN_API_KEY=change-me-too

# ── Your business (printed on every invoice) ─────────────────────────────────
SELLER_LEGAL_NAME=Precision 3D Studio Private Limited
SELLER_TRADE_NAME=Precision 3D Studio
SELLER_GSTIN=29AABCU9603R1ZJ
SELLER_PAN=AABCU9603R
SELLER_ADDRESS_LINE1=No. 42, 3rd Cross, 100 Feet Road
SELLER_ADDRESS_LINE2=Indiranagar
SELLER_CITY=Bengaluru
SELLER_STATE=Karnataka
# Two-digit GST state code. THIS DRIVES CGST+SGST vs IGST — get it right.
# 29 Karnataka · 27 Maharashtra · 33 Tamil Nadu · 07 Delhi · 24 Gujarat
SELLER_STATE_CODE=29
SELLER_PINCODE=560038
SELLER_PHONE=+919876500000
SELLER_EMAIL=orders@precision3d.example.com
# Optional PNG/JPG for the invoice header.
SELLER_LOGO_PATH=

# Set false if your turnover is below the GST registration threshold — the app
# then issues a Bill of Supply instead of a Tax Invoice and charges no GST.
GST_ENABLED=true

# UPI id for the "scan to pay" QR on unpaid invoices.
SELLER_UPI_ID=precision3d@okhdfcbank

BANK_NAME=HDFC Bank
BANK_ACCOUNT_NAME=Precision 3D Studio Private Limited
BANK_ACCOUNT_NUMBER=50200012345678
BANK_IFSC=HDFC0001234

CURRENCY=INR

# ── WhatsApp Cloud API ───────────────────────────────────────────────────────
# See docs/WHATSAPP_SETUP.md for how to obtain each of these.
WHATSAPP_API_VERSION=v21.0
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_BUSINESS_ACCOUNT_ID=
# Use a permanent System User token, not the 24-hour temporary one.
WHATSAPP_ACCESS_TOKEN=
# You invent this; paste the same string into the Meta webhook config.
WHATSAPP_VERIFY_TOKEN=pick-any-random-string
# Meta App Secret. Without it, webhook signatures cannot be verified.
WHATSAPP_APP_SECRET=
# Commerce Manager catalog id — this is what makes the in-chat storefront work.
WHATSAPP_CATALOG_ID=

# ── Payment gateway ──────────────────────────────────────────────────────────
# `mock` runs a local test checkout that moves no money. Switch to `razorpay`
# once your keys are live. See docs/PAYMENTS_SETUP.md.
PAYMENT_PROVIDER=mock
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# ── Pricing (the quote engine) ───────────────────────────────────────────────
# Machine time charge per hour, in rupees. Cover power, wear and depreciation.
PRICING_MACHINE_RATE_PER_HOUR=60
# Charged once per job for slicing and bed setup.
PRICING_SETUP_FEE=50
# Applied to (material + machine + labour) to cover overheads and profit.
PRICING_MARGIN_MULTIPLIER=1.35
# Allowance for failed prints and purge, as a fraction of material cost.
PRICING_WASTAGE_FACTOR=0.08
# Your own time, per hour, for finishing work.
PRICING_LABOUR_RATE_PER_HOUR=150

FREE_DELIVERY_THRESHOLD=999
DELIVERY_CHARGE=79

# HSN 3926 covers "other articles of plastics" — the usual code for 3D printed
# plastic goods. SAC 998912 covers printing/job-work services. Confirm both
# with your CA for your specific products.
DEFAULT_HSN_CODE=3926
DEFAULT_SAC_CODE=998912
DEFAULT_GST_RATE=18
